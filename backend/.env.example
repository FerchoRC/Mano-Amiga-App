PORT=4000
DATABASE_URL=postgresql://manoamiga:manoamiga@localhost:5432/manoamiga
NODE_ENV=development

# URL del frontend (enlaces de invitación y CORS)
APP_URL=http://localhost:5173
# Orígenes permitidos separados por coma. Si se omite, se usa APP_URL.
# CORS_ORIGINS=http://localhost:5173

# Minutos sin actividad antes de cerrar la sesión (HU-02)
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12
INVITATION_DAYS=7

# Correos de invitación con Resend. Sin clave, el administrador copia el enlace.
RESEND_API_KEY=
MAIL_FROM="ManoAmiga <no-responder@manoamiga.co>"
